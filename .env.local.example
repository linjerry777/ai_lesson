# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — one per product/tier. See lib/courses.ts.
# Default product (claude-code) self-serve tier — keeps the legacy var name:
STRIPE_PRICE_ID=price_...
# Optional cohort tier price for the same product:
STRIPE_PRICE_ID_CC_COHORT=price_...

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
